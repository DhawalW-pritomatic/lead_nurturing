# NexCRM Backend Environment Variables
# Copy this file to .env and fill in your actual values
# NEVER commit .env file to Git!

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
DATABASE_URL=postgres://username:password@localhost:5433/nexcrm
DB_HOST=localhost
DB_PORT=5433
DB_NAME=nexcrm
DB_USER=nexcrm
DB_PASSWORD=your_secure_password_here

# JWT Configuration
# Generate secure secrets: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_here_min_32_chars
JWT_REFRESH_SECRET=your_refresh_secret_here_min_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Redis Configuration
REDIS_URL=redis://localhost:6380

# SMTP Configuration (Email Sending)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
SMTP_FROM=Your Company <noreply@yourcompany.com>

# IMAP Configuration (Email Receiving - Lead Reply Import)
# Uses same Gmail account as SMTP by default
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your_email@gmail.com
IMAP_PASS=your_app_password_here

# File Upload Configuration
UPLOAD_DIR=../uploads

# Application URLs
BASE_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3001

# Optional: Error Tracking
# SENTRY_DSN=your_sentry_dsn_here

# Optional: Rate Limiting
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX_REQUESTS=1000
